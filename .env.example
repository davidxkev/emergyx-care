APP_NAME=Emergyx Care
APP_ENV=development
DATABASE_URL=sqlite:///data/emergyx_care.db
MOCK_ALERT_CHANNEL=false
EMERGYX_DEMO_PROFILE=local

FDA2_SENSOR_IP=192.168.1.100
FDA2_SENSOR_ID=fda2_main
FDA2_ROOM=demo_room
FDA2_PORT=6053
FDA2_API_PASSWORD=
FDA2_PERSON_KEY=111111111
FDA2_FALL_KEY=222222222
FDA2_LIGHT_KEY=333333333
FDA2_RGB_LIGHT_KEY=
ENABLE_ILLUMINANCE=true
# Optional multi-sensor replacement for the single FDA2_* settings above.
# FDA2_SENSORS='[{"sensor_id":"fda2_living_room","room":"living_room","host":"192.168.1.154","port":6053,"person_key":807585817,"fall_key":3722878921,"light_key":107269002,"rgb_light_key":3365290969,"enable_illuminance":true},{"sensor_id":"fda2_bedroom","room":"bedroom","host":"192.168.1.155","port":6053,"person_key":111111111,"fall_key":222222222,"light_key":333333333,"rgb_light_key":444444444,"enable_illuminance":true}]'
ILLUMINANCE_MIN_INTERVAL_SECONDS=5
SENSOR_RECONNECT_DELAY_SECONDS=5

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_GEMMA_EXPLANATIONS=false
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_POLL_INTERVAL_SECONDS=2

GEMMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma4:e2b

DASHBOARD_REFRESH_SECONDS=10
